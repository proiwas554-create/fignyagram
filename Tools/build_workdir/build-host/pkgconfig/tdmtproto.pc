prefix=/usr/local

Name: tdmtproto
Description: Telegram Library - MTProto implementation
Version: 1.8.69

CFlags: -I"${prefix}/include"
Libs: -L"${prefix}/lib" -ltdmtproto
Requires.private: tdactor tdnet tdutils
Libs.private: -L"/usr/local/Cellar/openssl@3/3.6.3/lib" -lcrypto -L"/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib" -lz
