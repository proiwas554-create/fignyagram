prefix=/usr/local

Name: tde2e
Description: Telegram Library - E2E
Version: 1.8.69

CFlags: -I"${prefix}/include"
Libs: -L"${prefix}/lib" -ltde2e
Requires.private: tdutils
Libs.private: -L"/tmp/openssl-ios" -llib -L"/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS27.2.sdk/usr/lib" -lz
