HEADER_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/WebRTC_Telegram $(PROJECT_DIR)/WebRTC_Telegram/modules $(PROJECT_DIR)/WebRTC_Telegram/api $(PROJECT_DIR)/WebRTC_Telegram/rtc_base $(PROJECT_DIR)/WebRTC_Telegram/pc $(PROJECT_DIR)/WebRTC_Telegram/call $(PROJECT_DIR)/WebRTC_Telegram/media $(PROJECT_DIR)/WebRTC_Telegram/common_audio $(PROJECT_DIR)/ThirdParty/BoringSSL/include
